{
  # A generic description of ten-odd nodes for the tests of the tool.
  "format": "server-interface",
  "namespace": "urn:example:server-interface",
  "nodeIdRule": "path",
  "root": {
    "name": "demoInterface",
    "children": [
      {
        "name": "sensors",
        "kind": "folder",
        "children": [
          {
            "name": "unitA",
            "children": [
              { "name": "flag",  "type": "Bool", "access": "ro", "description": "Flag of the unit" },
              { "name": "level", "type": "Real", "access": "ro", "description": "Level of the unit" },
              { "name": "pump's count", "type": "Int",  "access": "ro", "description": "Count of the unit" },
              { "name": "label", "type": "Char", "access": "ro", "description": "Label of the unit" }
            ]
          }
        ]
      },
      {
        "name": "settings",
        "kind": "folder",
        "children": [
          { "name": "setpoint", "type": "Real", "access": "rw", "description": "Setpoint" },
          { "name": "enable",   "type": "Bool", "access": "rw", "description": "Enable" },
          { "name": "mode",     "type": "Byte", "access": "rw", "description": "Mode" }
        ]
      }
    ]
  }
}
